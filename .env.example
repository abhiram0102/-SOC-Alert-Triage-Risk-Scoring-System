# ─── SOC Triage System — Environment Configuration ───────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it contains secrets.
#
#   cp .env.example .env
#   nano .env

# ─── REQUIRED: Threat Intelligence API Keys ───────────────────────────────────

# AbuseIPDB: https://www.abuseipdb.com/register
# Free tier: 1,000 lookups/day
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here

# VirusTotal: https://www.virustotal.com/gui/join-us
# Free tier: 4 requests/minute, 500/day
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# ─── Elasticsearch ────────────────────────────────────────────────────────────

ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_INDEX=suricata-alerts-*

# Only set if ES security is enabled (production)
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=your_password_here
# ES_VERIFY_CERTS=true

# ─── Redis Cache (optional) ───────────────────────────────────────────────────

USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your_redis_password

# ─── Pipeline Settings ────────────────────────────────────────────────────────

POLL_INTERVAL=30
BATCH_SIZE=50
FREQ_WINDOW_MINUTES=60
CACHE_TTL=3600

# ─── ML Model ─────────────────────────────────────────────────────────────────

MODEL_DIR=model
CONFIDENCE_THRESHOLD=0.70

# ─── Logging ──────────────────────────────────────────────────────────────────

LOG_LEVEL=INFO
LOG_FILE=logs/pipeline.log

# ─── Notifications (optional) ─────────────────────────────────────────────────

# Slack: Create an Incoming Webhook at https://api.slack.com/apps
SLACK_WEBHOOK_URL=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
ALERT_EMAIL_TO=analyst@yourcompany.com

# ─── API Rate Limiting ────────────────────────────────────────────────────────

ABUSEIPDB_RATE_LIMIT_DELAY=0.1
VIRUSTOTAL_RATE_LIMIT_DELAY=15.0
API_MAX_RETRIES=3
API_RETRY_BACKOFF=2.0
